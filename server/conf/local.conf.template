# Local development configuration template
# Copy this file to local.conf and fill in your development values
# local.conf should NOT be committed to version control and is included in .gitignore

include "application.conf"

# Secret key - set your own for local development
play.http.secret.key = "changeme"

# Silhouette authentication - set your own for local development
silhouette.authenticator.signer.key = "changeme" # Should be at least 16 characters
silhouette.authenticator.crypter.key = "changeme" # Should be at least 16 characters

# Google API settings - replace with your development credentials
silhouette.google.clientID = "your-client-id.apps.googleusercontent.com"
silhouette.google.clientSecret = "your-client-secret"
silhouette.google.redirectURL = "http://localhost:9000/authenticate/google"
youtube.api.key = "your-youtube-api-key"

# Discord API settings - replace with your LOCAL DEVELOPMENT Discord app credentials
# (the Discord app whose redirect URIs include http://localhost:9000/authenticate/discord)
silhouette.discord.clientID = "your-local-discord-client-id"
silhouette.discord.clientSecret = "your-local-discord-client-secret"
# Leave the redirectURL commented out: the relative default /authenticate/discord is
# resolved against the request host, so it becomes http://localhost:9000/authenticate/discord.
# silhouette.discord.redirectURL = "http://localhost:9000/authenticate/discord"

# Challonge API settings - replace with your development credentials
challonge.api.key = "your-challonge-api-key"

# Database settings - adjust for your local environment
slick.dbs.default.db.properties.url = "jdbc:postgresql://localhost:5432/ytchatinteraction"
slick.dbs.default.db.properties.user = "postgres"
slick.dbs.default.db.properties.password = "postgres"
